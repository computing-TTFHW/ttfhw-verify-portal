  "problems_encountered": [
    {
      "timestamp": "2026-09-21T15:30:12",
      "problem": "NPU 卡0(Critical)、卡1(Alarm) 状态异常，conftest.py 按 worker_id % device_count 分配设备，worker gw0 会分到物理卡0 导致 SetDevice 失败",
      "solution": "设置 ASCEND_RT_VISIBLE_DEVICES=2,3,4,5,6,7 限制容器只看到 6 张健康卡，device_count() 返回 6，set_device(0) 映射到物理卡2",
      "source": "conftest.py assign_npu + npu-smi 卡状态"
    },
    {
      "timestamp": "2026-09-21T15:30:12",
      "problem": ".pth 方式替代 pip install -e . 后 ascend backend 未注册（entry_points 未注册），backends 只有 amd/nvidia",
      "solution": "设置 TRITON_BACKENDS_IN_TREE=1，triton/backends/__init__.py 快速路径直接扫描 triton/backends/ 目录发现 ascend 后端",
      "source": "triton/backends/__init__.py _discover_backends()"
    },
